{
  "name": "deepseek-harness-desktop",
  "type": "module",
  "version": "0.10.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "Desktop application for DeepSeek Harness (dsh) — one-click local install and launch, no Node.js setup required.",
  "scripts": {
    "dev": "vite",
    "dev:plugins": "pnpm --filter \"./packages/*\" --filter !dsh-tauri-bundle --filter !dsh-tauri-tsdown -r --parallel run dev",
    "build:plugins": "tsx scripts/build-plugins.ts",
    "prebuild": "pnpm build:plugins",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "bumpp --pr",
    "test": "vitest",
    "lint": "eslint",
    "knip": "knip",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "icons": "tauri icon public/favicon.svg && tsx scripts/rebuild-macos-icon.ts"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.21.0",
    "@hairy/react-lib": "^1.52.0",
    "@hairy/utils": "^1.52.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@overlastic/react": "^0.9.0",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-if-lite": "^0.1.0",
    "react-use": "^17.6.1",
    "tailwind-variants": "^3.3.1",
    "valtio-define": "^1.4.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.1-rc.1",
    "@antfu/eslint-config": "^9.3.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/vite": "4.1.11",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bumpp": "12.2.1",
    "changelogithub": "15.0.5",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "knip": "^6.32.2",
    "pathe": "^2.0.3",
    "publint": "catalog:cli",
    "tailwindcss": "4.1.11",
    "tinyexec": "^1.3.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}