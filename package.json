{
  "name": "deepseek-harness-desktop",
  "type": "module",
  "version": "0.10.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "Desktop application for DeepSeek Harness (dsh) — one-click local install and launch, no Node.js setup required.",
  "scripts": {
    "dev": "vite",
    "dev:plugins": "pnpm --filter \"./packages/*\" --filter !dsh-tauri-bundle --filter !dsh-tauri-tsdown -r --parallel run dev",
    "build:plugins": "tsx scripts/build-plugins.ts",
    "prebuild": "pnpm build:plugins",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "bumpp --pr",
    "test": "vitest",
    "lint": "eslint",
    "knip": "knip",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "icons": "tauri icon public/favicon.svg && tsx scripts/rebuild-macos-icon.ts"
  },
  "dependencies": {
    "@gravity-ui/icons": "catalog:runtime",
    "@hairy/react-lib": "catalog:runtime",
    "@hairy/utils": "catalog:utils",
    "@heroui/react": "catalog:runtime",
    "@heroui/styles": "catalog:runtime",
    "@overlastic/react": "catalog:runtime",
    "@tanstack/react-query": "catalog:runtime",
    "@tauri-apps/api": "catalog:tauri",
    "@tauri-apps/plugin-clipboard-manager": "catalog:tauri",
    "i18next": "catalog:runtime",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "react-i18next": "catalog:runtime",
    "react-if-lite": "catalog:runtime",
    "react-use": "catalog:runtime",
    "tailwind-variants": "catalog:runtime",
    "valtio-define": "catalog:runtime"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-client-runtime": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-skill-filesystem": "catalog:dsh",
    "@eslint-react/eslint-plugin": "catalog:lint",
    "@tailwindcss/postcss": "catalog:build",
    "@tailwindcss/vite": "catalog:build",
    "@tauri-apps/cli": "catalog:tauri",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:build",
    "babel-plugin-react-compiler": "catalog:build",
    "bumpp": "catalog:release",
    "changelogithub": "catalog:release",
    "citty": "catalog:utils",
    "consola": "catalog:utils",
    "dotenv": "catalog:utils",
    "eslint": "catalog:lint",
    "eslint-plugin-react-refresh": "catalog:lint",
    "knip": "catalog:lint",
    "pathe": "catalog:utils",
    "publint": "catalog:cli",
    "tailwindcss": "catalog:build",
    "tinyexec": "catalog:utils",
    "tsx": "catalog:build",
    "typescript": "catalog:cli",
    "vite": "catalog:build",
    "vitest": "catalog:testing"
  }
}
